{$DOMAIN} {
	encode gzip

	# API dan dokumentasinya
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}

	# Sisa permintaan ke frontend Next.js
	handle {
		reverse_proxy web:3000
	}

	# Header keamanan global. Satu blok agar konsisten di semua handle.
	# CSP img-src dan connect-src mengizinkan tile.openstreetmap.org untuk
	# ubin peta. unsafe-inline pada script-src dan style-src dipakai
	# MapLibre yang menyisipkan style runtime.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), microphone=(self), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; media-src 'self' blob: data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://tile.openstreetmap.org; worker-src 'self' blob:; frame-ancestors 'none'"
	}

	# Token di query string (SSE jobs/stream) diretaksi di access log
	# supaya tidak tercatat permanen. Format filter mengganti token=[REDACTED].
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
		format filter {
			wrap console
			fields {
				uri replace `(\?|&)token=[^& ]+` `${1}token=[REDACTED]`
			}
		}
	}
}

# www diarahkan ke alamat utama supaya hanya ada satu URL resmi.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
