# Salin ke deploy/.env.prod lalu isi nilainya. Jangan commit file .env.prod.
DOMAIN=demo.gemahutan.example
ACME_EMAIL=email-untuk-laporan-sertifikat@example.com

POSTGRES_DB=gemahutan
POSTGRES_USER=gemahutan
POSTGRES_PASSWORD=ganti-dengan-password-panjang

S3_ACCESS_KEY=minio-user-demo
S3_SECRET_KEY=ganti-dengan-password-minio-panjang
S3_BUCKET=gemahutan-audio
S3_REGION=us-east-1

SECRET_KEY=ganti-dengan-random-32-bytes
JWT_SECRET=ganti-dengan-random-32-bytes-berbeda

# Origin yang boleh memanggil API dari browser.
CORS_ORIGINS=https://demo.gemahutan.example

# URL API yang dibaca browser. Kalau satu domain dengan Caddy, pakai path relatif ini.
PUBLIC_API_URL=https://demo.gemahutan.example/api/v1

# Kosongkan untuk mematikan pemakaian key pihak ketiga di server demo.
XC_API_KEY=
KAGGLE_API_TOKEN=

NODE_ENV=production
ENVIRONMENT=production
ENABLE_DOCS=false
# Pendaftaran publik dimatikan: akun dibuat oleh pengelola
ALLOW_REGISTRATION=false
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
