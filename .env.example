# Environment
NODE_ENV=development
ENVIRONMENT=development
ENABLE_DOCS=true
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://gemahutan:gemahutan@db:5432/gemahutan
DATABASE_URL_SYNC=postgresql://gemahutan:gemahutan@db:5432/gemahutan

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gemahutan-audio
S3_REGION=us-east-1

# Inference
INFERENCE_ENGINE=cascade

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Xeno-canto
XC_API_KEY=your-xeno-canto-api-key

# Kaggle
KAGGLE_API_TOKEN=your-kaggle-api-token

# Halaman depan publik: tiap pengunjung mendapat akun tamu sendiri.
DEMO_AKTIF=1
TAMU_AKTIF=true
TAMU_RAHASIA=ganti-dengan-string-acak-panjang
TAMU_BATAS_PER_JAM=30
TAMU_UMUR_JAM=24
