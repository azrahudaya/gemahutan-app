# Contoh env produksi untuk GemaHutan.
#
# Nilai di bawah ini placeholder, bukan kredensial sungguhan. Generate nilai
# kuat lewat `python3 ops/generate_secrets.py` lalu taruh di berkas .env.prod
# yang tidak dilacak git. ENVIRONMENT=production membuat API menolak start
# kalau SECRET_KEY, JWT_SECRET, S3_ACCESS_KEY, S3_SECRET_KEY, atau CORS_ORIGINS
# masih berisi nilai contoh atau localhost.
#
# Variabel DB (POSTGRES_PASSWORD, POSTGRES_USER, POSTGRES_DB) DAN DOMAIN juga
# wajib diisi sebelum `docker compose -f deploy/docker-compose.prod.yml config`
# valid. DOMAIN dipakai Caddy untuk sertifikat otomatis.

NODE_ENV=production
ENVIRONMENT=production
ENABLE_DOCS=false
ALLOW_REGISTRATION=false

# Domain publik. Caddy di deploy/docker-compose.prod.yml pakai ini untuk
# sertifikat otomatis. Pemeriksaan start API menolak localhost atau placeholder.
DOMAIN=gemahutan.example

# Nilai di bawah ini HARUS diganti sebelum deploy. Generate lewat:
#   python3 ops/generate_secrets.py
JWT_SECRET=isi-dengan-hasil-generate_secrets-py
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_KEY=isi-dengan-hasil-generate_secrets-py

# Database produksi. Pemakai DB dan sandi harus cocok dengan yang dipasang
# di deploy/docker-compose.prod.yml (variabel POSTGRES_PASSWORD).
# Generate sandi kuat: openssl rand -hex 24
POSTGRES_DB=gemahutan
POSTGRES_USER=gemahutan
POSTGRES_PASSWORD=isi-dengan-openssl-rand
DATABASE_URL_SYNC=postgresql://gemahutan:isi-sandi-db@gemahutan-db:5432/gemahutan
DATABASE_URL=postgresql+asyncpg://gemahutan:isi-sandi-db@gemahutan-db:5432/gemahutan

# Redis
REDIS_URL=redis://gemahutan-redis:6379/0

# MinIO / S3 (nilai dibuat lewat ops/generate_secrets.py)
S3_ENDPOINT=http://gemahutan-minio:9000
S3_ACCESS_KEY=isi-dengan-hasil-generate_secrets-py
S3_SECRET_KEY=isi-dengan-hasil-generate_secrets-py
S3_BUCKET=gemahutan-audio
S3_REGION=us-east-1

# Inference
INFERENCE_ENGINE=cascade

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Domain publik. Untuk produksi, isi dengan https://gemahutan.example.
# Pemeriksaan start akan menolak localhost.
CORS_ORIGINS=https://gemahutan.example

# Frontend (kosongkan untuk jalur relatif lewat Caddy)
NEXT_PUBLIC_API_URL=

# Worker
WORKER_HEARTBEAT_STALE_SECONDS=180