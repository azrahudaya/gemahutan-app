<mxfile host="gemahutan-diagram-lib"><diagram id="d1" name="alur_pemrosesan"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a" value="&lt;b&gt;1. Unggah atau rekam&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;web: 1-20 berkas, maks. 200 MB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="235" height="58" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;2. Validasi isi audio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;ffprobe: harus berisi audio&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="283" y="20" width="235" height="58" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;3. Simpan ke MinIO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;+ buat job di antrean Redis&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="545" y="20" width="235" height="58" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;4. Worker: unduh dan dekode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;mono 48 kHz, jendela 3 detik&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#00873F;strokeColor=#00873F;fontColor=#FFFFFF;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="340" height="58" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;5a. Track A: BirdNET 2.4 (zero-shot)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;6.522 spesies global, dengan filter&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;wilayah dari koordinat lokasi&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="320" height="70" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;5b. Track B: embedding BirdNET 1024&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;→ regresi logistik 25 spesies&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;+ kalibrasi suhu dan bias&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#9A5B00;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="440" y="206" width="320" height="70" as="geometry"/></mxCell><mxCell id="g" value="&lt;b&gt;6. Gabung hasil, ambang per spesies, penyaring:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;buang &amp;lt; 1 dtk; keyakinan &amp;lt; 0,5 harus muncul ≥2 kali&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="200" y="312" width="400" height="58" as="geometry"/></mxCell><mxCell id="h" value="&lt;b&gt;7. Indeks soundscape&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;ACI, NDSI, ADI, BI (scikit-maad)&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="235" height="52" as="geometry"/></mxCell><mxCell id="i" value="&lt;b&gt;8. Spektrogram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;(disimpan di MinIO)&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="283" y="410" width="235" height="52" as="geometry"/></mxCell><mxCell id="j" value="&lt;b&gt;9. Lokalisasi arah&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;bila rekaman ≥2 kanal&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="545" y="410" width="235" height="52" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;10. PostgreSQL + PostGIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;deteksi, indeks, status job&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="235" height="58" as="geometry"/></mxCell><mxCell id="l" value="&lt;b&gt;11. Dashboard, peta,&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;detail rekaman, ekspor&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F6EC;strokeColor=#00873F;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="283" y="510" width="235" height="58" as="geometry"/></mxCell><mxCell id="m" value="&lt;b&gt;12. Verifikasi ahli&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;benar / salah / ragu&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F6EC;strokeColor=#00873F;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="545" y="510" width="235" height="58" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#3F3F46;fontSize=10;fontStyle=2;fontColor=#52525B;fontFamily=Plus Jakarta Sans;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="49" as="sourcePoint"/><mxPoint x="283" y="49" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#3F3F46;fontSize=10;fontStyle=2;fontColor=#52525B;fontFamily=Plus Jakarta Sans;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518" y="49" as="sourcePoint"/><mxPoint x="545" y="49" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#3F3F46;fontSize=10;fontStyle=2;fontColor=#52525B;fontFamily=Plus Jakarta Sans;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="662" y="78" as="sourcePoint"/><mxPoint x="570" y="139" as="targetPoint"/><Array as="points"><mxPoint x="662" y="139"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#3F3F46;fontSize=10;fontStyle=2;fontColor=#52525B;fontFamily=Plus Jakarta Sans;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="168" as="sourcePoint"/><mxPoint x="200" y="206" as="targetPoint"/><Array as="points"><mxPoint x="330" y="187"/><mxPoint x="200" y="187"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#3F3F46;fontSize=10;fontStyle=2;fontColor=#52525B;fontFamily=Plus Jakarta Sans;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="168" as="sourcePoint"/><mxPoint x="600" y="206" as="targetPoint"/><Array as="points"><mxPoint x="470" y="187"/><mxPoint x="600" y="187"/></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;html=1;rounded=