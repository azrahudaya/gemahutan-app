<mxfile host="gemahutan-diagram-lib"><diagram id="d1" name="arsitektur"><mxGraphModel dx="800" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gw" value="Worker ARQ (Python, CPU): memproses satu rekaman per job" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A1A1AA;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=11;fontColor=#52525B;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="20" y="278" width="760" height="170" as="geometry"/></mxCell><mxCell id="gr" value="Di luar inti: alat lapangan (rencana, garis putus) dan layanan email" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A1A1AA;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=11;fontColor=#52525B;fontFamily=Plus Jakarta Sans;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="462" width="760" height="80" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Pengguna&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;ranger, peneliti, admin&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;(desktop atau ponsel)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="160" height="62" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Web Next.js 15 (PWA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;rekam, unggah, verifikasi,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;laporan, simulasi lokasi&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E5F6EC;strokeColor=#00873F;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="240" y="20" width="215" height="62" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;JWT + 3 peran, undangan akun,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;samarkan lokasi spesies prioritas&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#00873F;strokeColor=#00873F;fontColor=#FFFFFF;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="525" y="20" width="255" height="62" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL 16 + PostGIS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;rekaman, deteksi, verifikasi,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;lokasi, jejak audit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="240" height="62" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b&gt;Redis 7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;antrean job (ARQ), pencabutan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;token, pembatas laju&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="280" y="160" width="240" height="62" as="geometry"/></mxCell><mxCell id="minio" value="&lt;b&gt;MinIO (S3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;berkas audio asli&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;dan spektrogram&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="240" height="62" as="geometry"/></mxCell><mxCell id="bn" value="&lt;b&gt;Track A: BirdNET 2.4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;zero-shot, 6.522 spesies&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="36" y="312" width="200" height="50" as="geometry"/></mxCell><mxCell id="tb" value="&lt;b&gt;Track B: embedding 1024&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;+ regresi logistik,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;25 spesies Indonesia&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#9A5B00;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="36" y="372" width="200" height="62" as="geometry"/></mxCell><mxCell id="gab" value="&lt;b&gt;Gabung hasil&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;ambang per spesies&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;+ penyaring deteksi&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;lemah&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometry x="270" y="336" width="180" height="76" as="geometry"/></mxCell><mxCell id="lok" value="&lt;b&gt;Lokalisasi GCC-PHAT + triangulasi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;rekaman ≥2 kanal, juga dipakai&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.0px&quot;&gt;simulasi alat virtual&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#A1A1AA;fontColor=#09090B;fontSize=12.5;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1"><mxGeometr